{
  "name": "@tiktok-business/react-native-sdk",
  "version": "0.1.0",
  "description": "TikTok Business React Native SDK",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/app/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "dev": "turbo run start --filter=tiktok-business-react-native-sdk-example --continue=never",
    "example": "pnpm --filter tiktok-business-react-native-sdk-example",
    "example:start": "turbo run start --filter=tiktok-business-react-native-sdk-example --continue=never",
    "example:ios": "turbo run ios --filter=tiktok-business-react-native-sdk-example --continue=never",
    "example:android": "turbo run android --filter=tiktok-business-react-native-sdk-example --continue=never",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "sync:version": "node scripts/sync-version.cjs",
    "prepare": "pnpm build:root",
    "typecheck": "turbo run typecheck:root --continue=never",
    "lint": "turbo run lint:root --continue=never",
    "test": "turbo run test:root --continue=never",
    "check": "turbo run lint:root typecheck:root test:root --continue=never",
    "build": "turbo run build:root --continue=never",
    "build:ios": "turbo run build:ios --filter=tiktok-business-react-native-sdk-example --continue=never",
    "build:android": "turbo run build:android --filter=tiktok-business-react-native-sdk-example --continue=never",
    "release:prepare": "turbo run lint:root typecheck:root test:root build:root --continue=never",
    "lint:root": "eslint \"**/*.{js,ts,tsx}\"",
    "typecheck:root": "tsc",
    "test:root": "jest --runInBand",
    "build:root": "pnpm sync:version && bob build",
    "package:validate": "pnpm pack --dry-run",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiktok/tiktok-business-react-native-sdk.git"
  },
  "author": "TikTok Business Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tiktok/tiktok-business-react-native-sdk/issues"
  },
  "homepage": "https://github.com/tiktok/tiktok-business-react-native-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "lefthook": "^2.0.3",
    "prettier": "^2.8.8",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-builder-bob": "^0.40.18",
    "release-it": "^19.0.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "pnpm@10.26.2",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "TiktokBusinessReactNativeSdkSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.tiktokbusinessreactnativesdk"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "react-native",
    "moduleNameMapper": {
      "^@tiktok-business/react-native-sdk$": "<rootDir>/src/index"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/.claude/",
      "<rootDir>/.codex/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.57.1"
  }
}
